POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devdb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=123456789

# Local dev: localhost:1234 (odbc-api runs natively on Windows)
# Inside Docker: docker-compose.yml overrides this to http://host.docker.internal:1234
ODBC_API_URL=http://localhost:1234

ETL_INTERVAL_SECONDS=10

# Hours to load per historical backfill chunk (one chunk per scheduler cycle)
HISTORICAL_CHUNK_HOURS=1

# How many hours before NOW() the watermark must reach to auto-switch to INCREMENTAL
HISTORICAL_TRANSITION_HOURS=1

# IANA timezone of the historian server timestamps (e.g. UTC, America/Bogota)
HISTORIAN_TIMEZONE=UTC
