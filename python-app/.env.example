# PHD Hub Loader — Environment Variables
# Copy this file to .env and adjust values for your environment

# Port the FastAPI server listens on
PORT=8000

# Base URL of the app-backend REST API (must include /api)
BACKEND_URL=http://localhost:3000/api

# Base URL of the odbc-api PHD bridge (Windows native process)
ODBC_API_URL=http://localhost:1234
