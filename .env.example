# Shared Docker Compose environment variables
# Copy this file to .env and fill in the real values before deploying.
# NEVER commit .env with real credentials to version control.

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=devdb
POSTGRES_USER=myuser
POSTGRES_PASSWORD=

# ── Windows ODBC bridge ────────────────────────────────────────────────────
# Set to the real IP address or DNS name of the Windows host running odbc-api.
# Do NOT use localhost or host.docker.internal in production.
ODBC_API_URL=http://<IP_O_DNS_WINDOWS>:1234
HISTORIAN_SOURCE=postgres
ODBC_CONNECT_TIMEOUT_SECONDS=10
ODBC_READ_TIMEOUT_SECONDS=120

# ── ETL scheduler ──────────────────────────────────────────────────────────
# Seconds between ETL cycles. Adjust after measuring load and processing time.
ETL_INTERVAL_SECONDS=60
